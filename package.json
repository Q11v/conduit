{
  "name": "conduit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && env -u ELECTRON_RUN_AS_NODE electron .",
    "dev": "vite & trap 'kill 0' EXIT; CONDUIT_DEV_URL=http://localhost:5173/ env -u ELECTRON_RUN_AS_NODE electron .",
    "build": "vite build",
    "dist": "vite build && electron-builder --dir",
    "dist:dmg": "vite build && electron-builder",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "ssh-config": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-parser-oxc": "^0.1.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "main": "electron/main.js",
  "build": {
    "appId": "io.github.q11v.conduit",
    "productName": "conduit",
    "asar": false,
    "files": [
      "electron/**",
      "server/**",
      "bin/**",
      "web/dist/**",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "identity": null
    }
  }
}
